---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

// Newsletter signup is hosted on Substack (The Monthly Edge).
const SUBSTACK_EMBED = 'https://sportivityconsultants.substack.com/embed';

const title = `Subscribe | ${SITE_TITLE}`;
const description =
	'Sign up for the monthly Sportivity newsletter: practical leadership, productivity and AI strategies for SME owners and directors.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<section class="signup">
				<div class="signup-inner">
					<p class="eyebrow">The monthly edge</p>
					<h1>Sharper leadership, once a month.</h1>
					<p class="lede">
						Practical strategies for SME owners and directors: productivity, clarity and
						focus, performing in the room, better leadership, and the models, frameworks
						and AI ideas worth your time. No fluff, no spam, unsubscribe anytime.
					</p>

					<iframe
						class="substack-embed"
						src={SUBSTACK_EMBED}
						title="Subscribe to The Monthly Edge"
						loading="lazy"
						scrolling="no"
					></iframe>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
	}
	.signup {
		background: #111;
		color: #fff;
		padding: 4.5rem 1.5rem 5rem;
		text-align: center;
	}
	.signup-inner {
		max-width: 640px;
		margin: 0 auto;
	}
	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--accent);
		margin: 0 0 1rem;
	}
	.signup h1 {
		color: #fff;
		font-size: clamp(1.85rem, 4vw, 2.75rem);
		margin: 0 0 1rem;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}
	.signup .lede {
		font-size: 1.1rem;
		line-height: 1.6;
		color: #d4d4d8;
		margin: 0 auto 2.5rem;
		max-width: 560px;
	}
	.substack-embed {
		display: block;
		width: 100%;
		max-width: 480px;
		height: 360px;
		margin: 0 auto;
		border: 0;
		border-radius: 12px;
		background: #fff;
		box-shadow: var(--box-shadow);
	}
</style>
