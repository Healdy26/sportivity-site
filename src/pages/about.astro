---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { Image } from 'astro:assets';
import { SITE_TITLE } from '../consts';

import logoUA92 from '../assets/logos/ua92.png';
import logoAllIncompass from '../assets/logos/all-incompass.png';
import logoSportingPeople from '../assets/logos/sporting-ppl.png';
import logoTranscend from '../assets/logos/transcend.png';
import logoSwimEd from '../assets/logos/swim-ed.png';

const work = [
	{
		logo: logoUA92,
		name: 'UA92',
		role: 'Associate Lecturer & Module Leader',
		overview:
			'I write and deliver modules across Business Management, Sport Business Management, Digital Marketing and World of Sport, and support students through dissertations, projects and assessment. The aim is simple: bring real sector experience into the room so the next generation of sport and business leaders learn things they can actually use. My modules consistently score over 90% in module evaluation, including student feedback.',
		link: 'https://ua92.ac.uk/',
	},
	{
		logo: logoAllIncompass,
		name: 'All Incompass',
		role: 'Founder & Director of Strategic Partnerships',
		overview:
			"I co-founded All Incompass to do more for children in sport and physical activity, especially those with special educational needs. It's software and consultancy for children's activity providers, schools and local authorities, bringing booking, safeguarding, payments, compliance and practical advice into one place. It turns admin-heavy, fragmented systems into simpler tools, so providers spend less time fighting spreadsheets and more time delivering good, inclusive provision.",
		link: 'https://www.allincompass.uk/',
	},
	{
		logo: logoSportingPeople,
		name: 'Sporting People',
		role: 'Lead Consultant',
		overview:
			"I've known Steve Mitchell, the founder and owner of Sporting People, for over 20 years, and for the last four I've worked as one of their lead consultants through Sportivity. Together we've delivered high-impact work across inclusion, strategy, digital experience, workforce development and coach education, for the likes of the British Horseracing Authority, British Wheelchair Basketball and GB Wheelchair Rugby. It's a partnership built on long-term trust and handling complex, multi-stakeholder projects.",
		link: 'https://sportingpeople.co.uk/',
	},
	{
		logo: logoTranscend,
		name: 'Transcend Awards',
		role: 'Head of Quality',
		overview:
			'I was part of the team that built Transcend Awards from the start, an Ofqual-regulated awarding organisation, and stayed through its acquisition by Competence. As Head of Quality, I design qualifications, assessment methods, policies and the systems behind them, and lead on quality for training providers across the country. One standout is the FIFA Technical Leadership qualification, delivered successfully around the world.',
		link: 'https://www.transcendawards.co.uk/',
	},
	{
		logo: logoSwimEd,
		name: 'Swim:ED',
		role: 'Programme & Licence Model Lead',
		overview:
			"I was part of the team that developed the Swim:ED portable pool licence model and the whole programme from scratch: the processes, manuals, safety operating procedures and training that turn portable pools into a safe, scalable way to teach swimming and water safety. I've written and delivered training across the organisation and its national licensees, and I'm now leading the development of a Trade Association for Portable Pools. Product innovation, safety, training and national scale in one place.",
		link: 'https://swim-ed.co.uk/',
		extraLinks: [
			{ label: '2024-25 impact report', href: 'https://swim-ed.co.uk/impact-report/' },
			{ label: 'Read the stories', href: 'https://swim-ed.co.uk/stories/' },
		],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="Andy Heald: leadership consultant, keynote speaker and educator supporting leaders, schools, colleges, universities and national organisations. MBA, Chartered Fellow of CIMSPA and CMI." />
	</head>
	<body>
		<Header />
		<main>
			<!-- Page Hero -->
			<section class="page-hero">
				<div class="container">
					<p class="eyebrow">About</p>
					<h1>Better leaders. Smarter businesses. A healthier, happier world.</h1>
					<p class="lede">Sportivity Consultants helps individuals and organisations develop the clarity, confidence and capability needed to thrive in an increasingly complex world.</p>
				</div>
			</section>

			<!-- Andy Bio -->
			<section class="bio">
				<div class="container narrow">
					<h2>Meet Andy Heald</h2>
					<p>For over twenty years I've worked at the join between leadership, sport, education and business. I've built and scaled companies, taught in lecture halls, advised national bodies, and stood on stage in front of hundreds. But the thing that shaped me most was never on a CV.</p>
					<p>A few years ago I had what looked like the lot. A business turning over more than a million, a family, money in the bank, semi-pro football on a Saturday. Then it came apart, because I'd spent years trying to please everyone but myself. The breakdown that followed, and the long climb back, taught me more about leadership than any qualification ever did. It's why I believe, properly believe, that vulnerability is a superpower.</p>
					<p>Today I run Sportivity Consultants and work with the people who shape others: schools, colleges and universities, training providers, awarding bodies and national organisations. I help with strategy, quality and governance, leadership and coaching, and making sense of AI. I'm MBA-qualified, a Chartered Fellow of both CIMSPA and the CMI, and I've led quality across national networks, through Ofsted inspections and Ofqual-regulated qualifications. I still lecture too, because keeping a foot in the classroom keeps the work honest.</p>
					<p>I'm an entrepreneur at heart. I've founded businesses, scaled a network to seven figures, and built products from a blank page. That mix is what I bring to higher and further education: someone who knows the standards and the inspections, but who's also met a payroll and felt the weight of getting it wrong. Academic grounding, with the scars to back it up.</p>
					<p>What I care about is simple. Better leaders, smarter organisations, and people who feel a bit less alone in the hard parts. If that sounds like the help you're after, I'd love to hear what you're working on.</p>
				</div>
			</section>

			<!-- Belief / Pull Quote -->
			<section class="belief">
				<div class="container narrow">
					<p class="pull-quote">Exceptional leaders create exceptional organisations.</p>
					<p class="attribution">Andy's guiding belief</p>
				</div>
			</section>

			<!-- Approach -->
			<section class="approach">
				<div class="container narrow">
					<h2>The approach</h2>
					<p>Through consultancy, coaching, education and practical support, Andy helps individuals and organisations develop the clarity, confidence and capability needed to thrive in an increasingly complex world.</p>
					<p>Whether supporting leadership development, organisational change, workforce standards, quality assurance or strategic growth, the focus remains the same:</p>
					<ul class="focus-list">
						<li>Helping people make better decisions</li>
						<li>Building stronger organisations</li>
						<li>Creating positive impact</li>
					</ul>
				</div>
			</section>

			<!-- Credentials -->
			<section class="credentials">
				<div class="container">
					<h2>Credentials &amp; affiliations</h2>
					<div class="credential-grid">
						<div class="credential">
							<h3>MBA &amp; Level 7 Leadership</h3>
							<p>MBA with Merit, Level 7 Senior Leadership, and a Certificate of Education.</p>
						</div>
						<div class="credential">
							<h3>Higher &amp; Further Education</h3>
							<p>Lecturer and curriculum developer across HE and FE, experienced in Ofqual-regulated qualifications and Ofsted inspection.</p>
						</div>
						<div class="credential">
							<h3>Chartered Fellow</h3>
							<p>Chartered Fellow of CIMSPA and Fellow of the Chartered Management Institute.</p>
						</div>
						<div class="credential">
							<h3>20+ years experience</h3>
							<p>Working with grassroots providers, national governing bodies, and everything in between.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Selected work -->
			<section class="work">
				<div class="container">
					<header class="work-head">
						<h2>Selected work</h2>
						<p>A few of the organisations I've worked with, and what we did together.</p>
					</header>
					<div class="work-grid">
						{work.map((w) => (
							<article class="work-card">
								<div class="work-logo">
									<Image src={w.logo} alt={w.name} height={96} />
								</div>
								<h3>{w.name}</h3>
								<p class="work-role">{w.role}</p>
								<p class="work-overview">{w.overview}</p>
								<div class="work-links">
									<a href={w.link} target="_blank" rel="noopener" class="work-link">Visit {w.name} →</a>
									{w.extraLinks?.map((x) => (
										<a href={x.href} target="_blank" rel="noopener" class="work-link-sub">{x.label} →</a>
									))}
								</div>
							</article>
						))}
					</div>
				</div>
			</section>

			<LogoMarquee />

			<!-- Final CTA -->
			<section class="final-cta">
				<div class="container">
					<h2>Let's talk about your next step.</h2>
					<p>Book a free, no-obligation consultation. We'll talk through what you're trying to achieve and how Sportivity can help.</p>
					<a href="https://app.usemotion.com/meet/andy-heald/consultancy?d=60" class="btn btn-light" target="_blank" rel="noopener">Book a Free Consultation</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
	}

	.container {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}
	.container.narrow {
		max-width: 760px;
	}

	/* Page Hero */
	.page-hero {
		background: linear-gradient(135deg, #fafafa 0%, #ffffff 100%);
		padding: 4rem 1.5rem 3rem;
		text-align: center;
		border-bottom: 4px solid var(--accent);
	}
	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--accent);
		margin: 0 0 1rem;
	}
	.page-hero h1 {
		font-size: clamp(1.85rem, 4vw, 2.75rem);
		line-height: 1.2;
		margin: 0 auto 1.5rem;
		color: #111;
		max-width: 800px;
		letter-spacing: -0.02em;
	}
	.page-hero .lede {
		font-size: 1.15rem;
		line-height: 1.55;
		color: #444;
		margin: 0 auto;
		max-width: 700px;
	}

	/* Bio */
	.bio {
		padding: 4rem 0;
		background: #fff;
	}
	.bio h2,
	.approach h2,
	.credentials h2 {
		font-size: clamp(1.5rem, 3vw, 2rem);
		margin: 0 0 1.5rem;
		color: #111;
	}
	.bio p,
	.approach p {
		font-size: 1.075rem;
		line-height: 1.7;
		color: #333;
		margin: 0 0 1.25rem;
	}

	/* Pull quote */
	.belief {
		background: #111;
		color: #fff;
		padding: 4rem 0;
		text-align: center;
	}
	.pull-quote {
		font-size: clamp(1.5rem, 3.5vw, 2.25rem);
		font-weight: 700;
		font-style: italic;
		line-height: 1.3;
		color: #fff;
		margin: 0 auto 1rem;
		max-width: 720px;
	}
	.attribution {
		color: var(--accent);
		font-size: 0.95rem;
		letter-spacing: 0.05em;
		margin: 0;
	}

	/* Approach */
	.approach {
		padding: 4rem 0;
		background: #fff;
	}
	.focus-list {
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}
	.focus-list li {
		font-size: 1.075rem;
		line-height: 1.7;
		color: #333;
		padding: 0.5rem 0 0.5rem 1.5rem;
		position: relative;
	}
	.focus-list li::before {
		content: "→";
		color: var(--accent);
		position: absolute;
		left: 0;
		font-weight: 700;
	}

	/* Credentials */
	.credentials {
		background: #f5f5f5;
		padding: 4rem 0;
	}
	.credential-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
		margin-top: 2rem;
	}
	.credential {
		background: #fff;
		padding: 1.75rem;
		border-top: 4px solid var(--accent);
	}
	.credential h3 {
		font-size: 1.1rem;
		margin: 0 0 0.75rem;
		color: #111;
	}
	.credential p {
		font-size: 0.95rem;
		line-height: 1.6;
		color: #555;
		margin: 0;
	}

	/* Selected work */
	.work {
		padding: 4rem 0;
		background: #fff;
	}
	.work-head {
		text-align: center;
		margin-bottom: 2.5rem;
	}
	.work-head h2 {
		font-size: clamp(1.5rem, 3vw, 2rem);
		margin: 0 0 0.75rem;
		color: #111;
	}
	.work-head p {
		color: #555;
		margin: 0;
		font-size: 1.05rem;
	}
	.work-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
		max-width: 1000px;
		margin: 0 auto;
	}
	.work-card {
		display: flex;
		flex-direction: column;
		background: #fff;
		border: 1px solid #e5e5e5;
		border-top: 4px solid var(--accent);
		padding: 1.75rem;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.work-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
	}
	.work-logo {
		height: 46px;
		display: flex;
		align-items: center;
		margin-bottom: 1.1rem;
	}
	.work-logo img {
		height: 40px;
		width: auto;
		max-width: 175px;
	}
	.work-card h3 {
		font-size: 1.2rem;
		margin: 0 0 0.3rem;
		color: #111;
	}
	.work-role {
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin: 0 0 0.9rem;
	}
	.work-overview {
		font-size: 0.95rem;
		line-height: 1.6;
		color: #444;
		margin: 0 0 1.25rem;
		flex: 1;
	}
	.work-links {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.6rem;
	}
	.work-link {
		font-weight: 600;
		font-size: 0.9rem;
		color: #111;
		text-decoration: none;
		border-bottom: 2px solid var(--accent);
		padding-bottom: 2px;
		transition: color 0.2s ease;
	}
	.work-link:hover {
		color: var(--accent);
	}
	.work-link-sub {
		font-weight: 600;
		font-size: 0.85rem;
		color: var(--accent);
		text-decoration: none;
	}
	.work-link-sub:hover {
		text-decoration: underline;
	}

	/* Buttons */
	.btn {
		display: inline-block;
		padding: 0.85rem 1.75rem;
		font-weight: 600;
		font-size: 1rem;
		text-decoration: none;
		border-radius: 4px;
		transition: all 0.2s ease;
		border: 2px solid transparent;
	}
	.btn-light {
		background: #fff;
		color: var(--accent);
		border-color: #fff;
	}
	.btn-light:hover {
		background: #111;
		color: #fff;
		border-color: #111;
	}

	/* Final CTA */
	.final-cta {
		background: var(--accent);
		color: #fff;
		padding: 4rem 1.5rem;
		text-align: center;
	}
	.final-cta h2 {
		color: #fff;
		font-size: clamp(1.75rem, 3.5vw, 2.25rem);
		margin: 0 0 1rem;
	}
	.final-cta p {
		font-size: 1.15rem;
		max-width: 600px;
		margin: 0 auto 2rem;
		opacity: 0.95;
	}

	@media (max-width: 640px) {
		.page-hero {
			padding: 3rem 1rem 2.5rem;
		}
		.bio,
		.approach,
		.credentials {
			padding: 3rem 0;
		}
	}
</style>