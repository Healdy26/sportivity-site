---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="Andy Heald — MBA-qualified leadership consultant, Associate Lecturer at UA92, and Fellow of CIMSPA." />
	</head>
	<body>
		<Header />
		<main>
			<!-- Page Hero -->
			<section class="page-hero">
				<div class="container">
					<p class="eyebrow">About</p>
					<h1>Better leaders. Smarter businesses. A healthier, happier world.</h1>
					<p class="lede">Sportivity Consultants helps individuals and organisations develop the clarity, confidence and capability needed to thrive in an increasingly complex world.</p>
				</div>
			</section>

			<!-- Andy Bio -->
			<section class="bio">
				<div class="container narrow">
					<h2>Meet Andy Heald</h2>
					<p>Andy is an MBA-qualified leadership consultant, Associate Lecturer in Sport Business Management and Business Management at UA92, and Fellow of the Chartered Institute for the Management of Sport and Physical Activity (FCIMSPA).</p>
					<p>For more than 20 years, Andy has worked at the intersection of leadership, sport, education, business and organisational development. His career has included roles as a business owner, entrepreneur, coach, educator, quality assurance advisor and strategic consultant, supporting organisations ranging from grassroots providers to national governing bodies.</p>
				</div>
			</section>

			<!-- Belief / Pull Quote -->
			<section class="belief">
				<div class="container narrow">
					<p class="pull-quote">Exceptional leaders create exceptional organisations.</p>
					<p class="attribution">— Andy's guiding belief</p>
				</div>
			</section>

			<!-- Approach -->
			<section class="approach">
				<div class="container narrow">
					<h2>The approach</h2>
					<p>Through consultancy, coaching, education and practical support, Andy helps individuals and organisations develop the clarity, confidence and capability needed to thrive in an increasingly complex world.</p>
					<p>Whether supporting leadership development, organisational change, workforce standards, quality assurance or strategic growth, the focus remains the same:</p>
					<ul class="focus-list">
						<li>Helping people make better decisions</li>
						<li>Building stronger organisations</li>
						<li>Creating positive impact</li>
					</ul>
				</div>
			</section>

			<!-- Credentials -->
			<section class="credentials">
				<div class="container">
					<h2>Credentials &amp; affiliations</h2>
					<div class="credential-grid">
						<div class="credential">
							<h3>MBA</h3>
							<p>Postgraduate qualification in business administration and management.</p>
						</div>
						<div class="credential">
							<h3>UA92 — Associate Lecturer</h3>
							<p>Teaching across Sport Business Management and Business Management programmes at UA92, Manchester.</p>
						</div>
						<div class="credential">
							<h3>FCIMSPA</h3>
							<p>Fellow of the Chartered Institute for the Management of Sport and Physical Activity — the sector's professional body.</p>
						</div>
						<div class="credential">
							<h3>20+ years experience</h3>
							<p>Working with grassroots providers, national governing bodies, and everything in between.</p>
						</div>
					</div>
				</div>
			</section>

			<LogoMarquee />

			<!-- Final CTA -->
			<section class="final-cta">
				<div class="container">
					<h2>Let's talk about your next step.</h2>
					<p>Book a free, no-obligation consultation — we'll talk through what you're trying to achieve and how Sportivity can help.</p>
					<a href="https://app.usemotion.com/meet/andy-heald/consultancy?d=60" class="btn btn-light" target="_blank" rel="noopener">Book a Free Consultation</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
	}

	.container {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}
	.container.narrow {
		max-width: 760px;
	}

	/* Page Hero */
	.page-hero {
		background: linear-gradient(135deg, #fafafa 0%, #ffffff 100%);
		padding: 4rem 1.5rem 3rem;
		text-align: center;
		border-bottom: 4px solid var(--accent);
	}
	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--accent);
		margin: 0 0 1rem;
	}
	.page-hero h1 {
		font-size: clamp(1.85rem, 4vw, 2.75rem);
		line-height: 1.2;
		margin: 0 auto 1.5rem;
		color: #111;
		max-width: 800px;
		letter-spacing: -0.02em;
	}
	.page-hero .lede {
		font-size: 1.15rem;
		line-height: 1.55;
		color: #444;
		margin: 0 auto;
		max-width: 700px;
	}

	/* Bio */
	.bio {
		padding: 4rem 0;
		background: #fff;
	}
	.bio h2,
	.approach h2,
	.credentials h2 {
		font-size: clamp(1.5rem, 3vw, 2rem);
		margin: 0 0 1.5rem;
		color: #111;
	}
	.bio p,
	.approach p {
		font-size: 1.075rem;
		line-height: 1.7;
		color: #333;
		margin: 0 0 1.25rem;
	}

	/* Pull quote */
	.belief {
		background: #111;
		color: #fff;
		padding: 4rem 0;
		text-align: center;
	}
	.pull-quote {
		font-size: clamp(1.5rem, 3.5vw, 2.25rem);
		font-weight: 700;
		font-style: italic;
		line-height: 1.3;
		color: #fff;
		margin: 0 auto 1rem;
		max-width: 720px;
	}
	.attribution {
		color: var(--accent);
		font-size: 0.95rem;
		letter-spacing: 0.05em;
		margin: 0;
	}

	/* Approach */
	.approach {
		padding: 4rem 0;
		background: #fff;
	}
	.focus-list {
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}
	.focus-list li {
		font-size: 1.075rem;
		line-height: 1.7;
		color: #333;
		padding: 0.5rem 0 0.5rem 1.5rem;
		position: relative;
	}
	.focus-list li::before {
		content: "→";
		color: var(--accent);
		position: absolute;
		left: 0;
		font-weight: 700;
	}

	/* Credentials */
	.credentials {
		background: #f5f5f5;
		padding: 4rem 0;
	}
	.credential-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
		margin-top: 2rem;
	}
	.credential {
		background: #fff;
		padding: 1.75rem;
		border-top: 4px solid var(--accent);
	}
	.credential h3 {
		font-size: 1.1rem;
		margin: 0 0 0.75rem;
		color: #111;
	}
	.credential p {
		font-size: 0.95rem;
		line-height: 1.6;
		color: #555;
		margin: 0;
	}

	/* Buttons */
	.btn {
		display: inline-block;
		padding: 0.85rem 1.75rem;
		font-weight: 600;
		font-size: 1rem;
		text-decoration: none;
		border-radius: 4px;
		transition: all 0.2s ease;
		border: 2px solid transparent;
	}
	.btn-light {
		background: #fff;
		color: var(--accent);
		border-color: #fff;
	}
	.btn-light:hover {
		background: #111;
		color: #fff;
		border-color: #111;
	}

	/* Final CTA */
	.final-cta {
		background: var(--accent);
		color: #fff;
		padding: 4rem 1.5rem;
		text-align: center;
	}
	.final-cta h2 {
		color: #fff;
		font-size: clamp(1.75rem, 3.5vw, 2.25rem);
		margin: 0 0 1rem;
	}
	.final-cta p {
		font-size: 1.15rem;
		max-width: 600px;
		margin: 0 auto 2rem;
		opacity: 0.95;
	}

	@media (max-width: 640px) {
		.page-hero {
			padding: 3rem 1rem 2.5rem;
		}
		.bio,
		.approach,
		.credentials {
			padding: 3rem 0;
		}
	}
</style>