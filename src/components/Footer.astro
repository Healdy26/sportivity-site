---
const today = new Date();
---

<footer>
	<div class="footer-top">
		<a href="/" class="footer-logo-link">
			<img src="/logo.png" alt="Sportivity Consultants" class="footer-logo" />
		</a>
	</div>
	<div class="footer-inner">
		<div class="footer-col">
			<h4>About</h4>
			<p>Creating exceptional leaders for smarter businesses and a healthier, happier world.</p>
		</div>
		<div class="footer-col">
			<h4>Contact</h4>
			<p><a href="mailto:andy@sportivityconsultants.com">andy@sportivityconsultants.com</a></p>
			<p><a href="tel:+447920008421">07920 008 421</a></p>
			<p>Greater Manchester · Operating nationally</p>
			<p><a href="https://www.linkedin.com/in/andy-heald-sportivity/" target="_blank" rel="noopener">LinkedIn</a></p>
			<p><a href="https://calendly.com/andy-sportivityconsultants/30min" target="_blank" rel="noopener">Book a Consultation →</a></p>
		</div>
		<div class="footer-col">
			<h4>Sitemap</h4>
			<p><a href="/">Home</a></p>
			<p><a href="/about/">About</a></p>
			<p><a href="/services/">Services</a></p>
			<p><a href="/blog/">Blog</a></p>
			<p><a href="/newsletter/">Newsletter</a></p>
			<p><a href="/contact/">Contact</a></p>
		</div>
	</div>
	<div class="footer-bottom">
		<p>&copy; {today.getFullYear()} Sportivity Consultants. All rights reserved.</p>
	</div>
</footer>

<style>
	footer {
		background: #111;
		color: #d4d4d8;
		padding: 4rem 1.5rem 0;
	}
	.footer-top {
		max-width: 1100px;
		margin: 0 auto 3rem;
		text-align: center;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid #2a2a2a;
	}
	.footer-logo-link {
		display: inline-block;
	}
	.footer-logo {
		height: 70px;
		width: auto;
		filter: brightness(0) invert(1);
		opacity: 0.95;
	}
	.footer-inner {
		max-width: 1100px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 2.5rem;
		padding-bottom: 3rem;
	}
	.footer-col h4 {
		color: var(--accent);
		font-size: 0.95rem;
		margin: 0 0 1rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.footer-col p {
		margin: 0 0 0.5rem;
		color: #d4d4d8;
		font-size: 0.95rem;
		line-height: 1.5;
	}
	.footer-col a {
		color: #d4d4d8;
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.footer-col a:hover {
		color: var(--accent);
	}
	.footer-bottom {
		border-top: 1px solid #2a2a2a;
		padding: 1.5rem 0;
		text-align: center;
	}
	.footer-bottom p {
		margin: 0;
		color: #888;
		font-size: 0.85rem;
	}

	@media (max-width: 640px) {
		footer {
			padding-top: 3rem;
			padding-left: 1rem;
			padding-right: 1rem;
		}
		.footer-inner {
			gap: 2rem;
		}
		.footer-logo {
			height: 54px;
		}
	}
</style>